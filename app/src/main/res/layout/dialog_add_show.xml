<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    android:layout_margin="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="יצירת הופעה חדשה 📍"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <AutoCompleteTextView
            android:id="@+id/etShowAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="איפה ההופעה? (למשל: רוטשילד 1, תל אביב)"
            android:background="@drawable/edit_text_rounded"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:completionThreshold="2" />

        <EditText
            android:id="@+id/etShowDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="באיזה תאריך?"
            android:focusable="false"
            android:clickable="true"
            android:background="@drawable/edit_text_rounded"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etShowTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="באיזו שעה מתחילים?"
            android:focusable="false"
            android:clickable="true"
            android:background="@drawable/edit_text_rounded"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etShowStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="סגנון (פופ, רוק, ג'אז...)"
            android:background="@drawable/edit_text_rounded"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnConfirmAddShow"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="פרסם והוסף נעץ"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            app:cornerRadius="15dp"
            android:textStyle="bold"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>