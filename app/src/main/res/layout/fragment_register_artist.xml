<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/beat_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center_horizontal">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgArtistProfileUpload"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="#F0F0F0"
                android:clickable="true"
                android:contentDescription="Profile Picture"
                android:focusable="true"
                android:padding="2dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/beat_primary"
                app:strokeWidth="2dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/FloatingActionButton"
                android:layout_width="61dp"
                android:layout_height="55dp"
                android:layout_alignEnd="@id/imgArtistProfileUpload"
                android:layout_alignBottom="@id/imgArtistProfileUpload"
                android:contentDescription="Add Photo"
                android:elevation="2dp"
                android:src="@android:drawable/ic_input_add"
                app:backgroundTint="@color/beat_primary"
                app:fabSize="mini"
                app:tint="@color/white" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artist_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/beat_primary"
            android:layout_marginBottom="0dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artist_subtitle"
            android:textSize="11sp"
            android:alpha="0.6"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="בחר סוג אמן:"
            android:textSize="13sp"
            android:layout_gravity="end"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:alpha="0.8"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/artistTypeToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnTypeMusician"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeDJ"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DJ"
                android:textSize="14sp"
                app:strokeColor="@color/beat_primary"
                app:icon="@drawable/ic_dj"
                app:iconTint="@null"
                app:iconSize="30sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeMusician"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="זמר"
                android:textSize="14sp"
                app:strokeColor="@color/beat_primary"
                app:icon="@drawable/ic_singer"
                app:iconTint="@null"
                app:iconSize="30sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeComedian"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="קומיקאי"
                android:textSize="14sp"
                app:icon="@drawable/ic_standup"
                app:iconTint="@null"
                app:iconSize="30sp"
                app:strokeColor="@color/beat_primary" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArtistFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="שם מלא(full name)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white"
            android:layout_marginBottom="2dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArtistFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="שם במה(stage name)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_media_play"
            android:layout_marginBottom="2dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilArtistBirthDate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="תאריך לידה(birth date)"
                android:layout_marginEnd="2dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundColor="@color/white">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etArtistBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:textSize="13sp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="date"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilInstrument"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="כלי נגינה/ציוד(instruments)"
                android:layout_marginStart="2dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundColor="@color/white">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInstrument"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArtistEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="דואר אלקטרוני(E-mail)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            android:layout_marginBottom="2dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArtistEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArtistUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="שם משתמש(username)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white"
            android:layout_marginBottom="2dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArtistUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArtistPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="סיסמה(password)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
            android:layout_marginBottom="2dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArtistPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArtistConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="אישור סיסמה(confirm password)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
            android:layout_marginBottom="2dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArtistConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArtistPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="מספר טלפון(phone number)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_menu_call"
            android:layout_marginBottom="2dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArtistPhone"
                android:inputType="phone"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ספר קצת על עצמך (Bio - רשות)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="@color/white"
            android:layout_marginBottom="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:lines="3"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSocialLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="לינק לאינסטגרם(instgram link)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSocialLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="textUri"/>
        </com.google.android.material.textfield.TextInputLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/spinner_bg"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp">
            <Spinner
                android:id="@+id/spinnerArtistGenre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:entries="@array/music_genres"
                android:padding="4dp"/>
        </RelativeLayout>

        <Button
            android:id="@+id/btnRegisterArtist"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_create_artist"
            android:backgroundTint="@color/beat_primary"
            app:cornerRadius="10dp"
            android:textStyle="bold"
            android:textSize="15sp"/>

    </LinearLayout>
</ScrollView>